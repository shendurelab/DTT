source("~/work/scripts/utils.R")
dat = read.csv("~/Downloads/Step1File_DebrisTAPE_v251118.csv", header=F)
dim(dat)
mat = dat %>% dcast(V2 ~ V1, fill = 0)
rownames(mat) = mat[,1]
mat = as.matrix(mat[,-1])
mat_rowSum = apply(mat, 1, sum)
mat_colSum = apply(mat, 2, sum)
mat_filter = mat[mat_rowSum >= 1000,]
dim(mat_filter)
head(mat_filter)
mat_filter[1,]
mat_filter_norm = t(t(mat_filter)/apply(mat_filter, 2, sum)) * 10000
mat_filter_norm[1,]
dim(mat_filter_norm)
cor_mat = cor(mat_filter_norm)
dim(cor_mat)
cor_mat[1:5,1:5]
library("gplots")
library(RColorBrewer)
library(viridis)
Colors=rev(brewer.pal(11,"Spectral"))
Colors=colorRampPalette(Colors)(120)
heatmap.2(as.matrix(cor_mat),
col=Colors,
#col=viridis(100),
scale="col",
Rowv = F,
Colv = F,
key=T,
density.info="none",
trace="none",
cexRow = 0.5,
cexCol = 0.5,
margins = c(10,5))
heatmap.2(as.matrix(cor_mat),
col=Colors,
#col=viridis(100),
scale="col",
Rowv = T,
Colv = T,
key=T,
density.info="none",
trace="none",
cexRow = 0.5,
cexCol = 0.5,
margins = c(10,5))
heatmap.2(as.matrix(cor_mat),
col=Colors,
#col=viridis(100),
scale="col",
Rowv = T,
Colv = T,
key=T,
density.info="none",
trace="none",
cexRow = 0.5,
cexCol = 0.5)
heatmap(
cor_mat,
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
graphics.off()
heatmap(
cor_mat,
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
cor_mat = cor(mat_filter_norm, method = "spearman")
heatmap(
cor_mat,
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
x = matrix(sample(1:20,12), 3, 4)
x
scale(x)
scale(x[,1])
obj = CreateSeuratObject(mat_filter)
obj = NormalizeData(obj, normalization.method = "LogNormalize", scale.factor = 10000)
obj = FindVariableFeatures(obj, selection.method = "vst")
obj = ScaleData(object = obj, verbose = FALSE)
obj
mat_filter_norm_scale = GetAssayData(obj, slot = "scale.data")
dim(mat_filter_norm_scale)
cor_mat = cor(mat_filter_norm_scale)
heatmap(
cor_mat,
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
mat_filter_norm = GetAssayData(obj, slot = "data")
cor_mat = cor(mat_filter_norm)
dim(mat_filter_norm)
class(mat_filter_norm)
cor_mat = cor(as.matrix(mat_filter_norm))
heatmap(
cor_mat,
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
cor_mat = cor(as.matrix(mat_filter_norm))
heatmap(
cor_mat,
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
mat_filter_norm = GetAssayData(obj, slot = "data")
cor_mat = cor(as.matrix(mat_filter_norm))
heatmap(
cor_mat,
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
mat_filter = GetAssayData(obj, slot = "counts")
cor_mat = cor(as.matrix(mat_filter))
heatmap(
cor_mat,
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
obj = CreateSeuratObject(mat_filter)
obj = NormalizeData(obj, normalization.method = "LogNormalize", scale.factor = 10000)
obj = FindVariableFeatures(obj, selection.method = "vst")
obj = ScaleData(object = obj, verbose = FALSE)
obj = RunPCA(object = obj, npcs = 30, verbose = FALSE)
emb = Embeddings(obj, reduction = 'pca')
dim(emb)
cor_mat = cor(t(emb))
heatmap(
cor_mat,
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
cor_mat = cor(mat_filter)
dim(mat_filter)
cor_mat = cor(as.matrix(mat_filter))
heatmap(
cor_mat,
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
heatmap(
cor_mat,
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
mat_norm <- mat_filter / sqrt(colSums(mat_filter^2))
cos_sim <- t(mat_norm) %*% mat_norm
dim(cos_sim)
heatmap(
cos_sim,
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
heatmap(
as.matrix(cos_sim),
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
cos_sim
cos_dist <- 1 - cos_sim
heatmap(
as.matrix(cos_dist),
symm = TRUE,
col = colorRampPalette(c("blue", "white", "red"))(100)
)
summary(cos_dist)
summary(c(cos_dist))
summary(c(as.matrix(cos_dist)))
